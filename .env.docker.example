# .env.docker.example — environment variables for full Docker Compose deployment
#
# Copy to .env and fill in your values:
#   cp .env.docker.example .env
#
# Key difference from .env.example: service hostnames use Docker-internal names
# (postgres, redis) instead of localhost. This file is for `docker compose up -d`.

# ─── Required secrets ────────────────────────────────────────────────────────
# Auto-generate with: openssl rand -hex 32

POSTGRES_PASSWORD=change-me-strong-password
REDIS_PASSWORD=change-me-redis-password
JWT_SECRET=change-me-jwt-secret
CREDENTIAL_VAULT_KEY=change-me-64-hex-chars-exactly-00000000000000000000000000000000

# ─── Database (Docker-internal hostnames) ─────────────────────────────────────
POSTGRES_DB=bex
POSTGRES_USER=bex
DATABASE_URL=postgresql://bex:change-me-strong-password@postgres:5432/bex
REDIS_URL=redis://:change-me-redis-password@redis:6379

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Fill in whichever you use:

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# ─── Notification channels ────────────────────────────────────────────────────
DEFAULT_APPROVAL_CHANNEL=telegram

# Telegram (run with: docker compose --profile telegram up -d)
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_CHAT_ID=
TELEGRAM_DEFAULT_AGENT_ID=
BEX_BOT_API_KEY=

# Teams (run with: docker compose --profile teams up -d)
# TEAMS_BOT_ID=
# TEAMS_BOT_PASSWORD=
# TEAMS_DEFAULT_AGENT_ID=

# WhatsApp (run with: docker compose --profile whatsapp up -d)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_APPROVAL_TO=whatsapp:+1234567890

# ─── Public URLs ──────────────────────────────────────────────────────────────
# Set to your server's public address (used for approval callback links + dashboard links)
PERMISSION_GATEWAY_CALLBACK_URL=https://your-server.example.com
DASHBOARD_URL=https://your-server.example.com:3000

# ─── Dashboard ────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4001

# ─── Skill Registry ───────────────────────────────────────────────────────────
SKILL_REGISTRY_URL=https://bexregistry.brendanbonner.com
SKILL_REGISTRY_TOKEN=your-registry-token-here

# ─── Defaults ─────────────────────────────────────────────────────────────────
DEFAULT_AGENT_POSTURE=SUPERVISED
COORDINATOR_LLM_PROVIDER=openai
COORDINATOR_LLM_MODEL=gpt-4o
MESH_AUTO_START_WORKERS=true
LOG_LEVEL=info
