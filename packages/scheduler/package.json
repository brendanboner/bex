{
  "name": "@bex/scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "BullMQ-based job queue and cron scheduling for agent tasks",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@bex/shared": "*",
    "@bex/orchestrator": "*",
    "@bex/knowledge-store": "*",
    "@prisma/client": "^5.17.0",
    "bullmq": "^5.12.12",
    "cron-parser": "^4.9.0",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsx": "^4.19.0",
    "typescript": "*",
    "vitest": "^2.0.5"
  }
}
