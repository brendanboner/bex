{
  "name": "@bex/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Fastify API gateway — auth, routing, audit logging",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^0.0.48",
    "@ai-sdk/azure": "^0.0.28",
    "@ai-sdk/openai": "^0.0.62",
    "@bex/agent-mesh": "*",
    "@bex/coordinator": "*",
    "@bex/credential-vault": "*",
    "@bex/knowledge-store": "*",
    "@bex/orchestrator": "*",
    "@bex/permission-gateway": "*",
    "@bex/persona-factory": "*",
    "@bex/scheduler": "*",
    "@bex/shared": "*",
    "@bex/skill-engine": "*",
    "@bex/skill-registry-client": "*",
    "@bex/ssh-executor": "*",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@prisma/client": "^5.17.0",
    "@types/bcrypt": "^6.0.0",
    "ai": "^3.4.33",
    "bcrypt": "^6.0.0",
    "fastify": "^4.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsx": "^4.19.0",
    "typescript": "*",
    "vitest": "^2.0.5"
  }
}
