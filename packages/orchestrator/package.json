{
  "name": "@bclaw/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Core agent execution engine — LLM routing, tool execution, credential proxying",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^0.0.48",
    "@ai-sdk/azure": "^0.0.28",
    "@ai-sdk/openai": "^0.0.62",
    "@bclaw/credential-vault": "*",
    "@bclaw/permission-gateway": "*",
    "@bclaw/shared": "*",
    "@bclaw/skill-engine": "*",
    "@bclaw/ssh-executor": "*",
    "@prisma/client": "^5.17.0",
    "@types/jsonwebtoken": "^9.0.6",
    "ai": "^3.4.7",
    "bullmq": "^5.12.12",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.23.8",
    "@bclaw/skill-registry-client": "*"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "typescript": "*",
    "vitest": "^2.0.5"
  }
}
