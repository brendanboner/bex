generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  externalId   String            @unique
  displayName  String            @default("")
  email        String?           @unique
  passwordHash String?
  isSystemUser Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  agents       Agent[]
  requests     AgentRequest[]
  approvals    ApprovalRequest[]
  credentials  Credential[]
}

model Agent {
  id           String         @id @default(cuid())
  name         String
  description  String?
  status       AgentStatus    @default(DRAFT)
  persona      Json           @default("{}")
  llmProvider  String         @default("openai")
  llmModel     String         @default("gpt-4o")
  llmConfig    Json           @default("{}")
  permissions  String[]       @default([])
  ownerId      String
  personaId    String?
  charterId    String?        @unique
  credentialId String?
  isDefault    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  charter      AgentCharter?  @relation(fields: [charterId], references: [id])
  credential   Credential?    @relation(fields: [credentialId], references: [id])
  owner        User           @relation(fields: [ownerId], references: [id])
  persona_ref  Persona?       @relation(fields: [personaId], references: [id])
  requests     AgentRequest[]
  agentSkills  AgentSkill[]

  @@index([ownerId])
  @@index([status])
  @@index([isDefault])
}

model AgentCharter {
  id                 String         @id @default(cuid())
  mandate            String
  posture            AgentPosture   @default(SUPERVISED)
  bearing            AgentBearing   @default(CONCISE)
  verbosity          AgentVerbosity @default(STANDARD)
  conductBoundaries  String[]       @default([])
  escalationTriggers String[]       @default([])
  scopeLimits        Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  agent              Agent?
}

model Skill {
  id                     String            @id @default(cuid())
  name                   String
  domain                 String
  description            String?
  version                String
  status                 SkillStatus       @default(DRAFT)
  capabilities           String[]
  tools                  Json              @default("[]")
  systemPrompt           String?
  learnedNotes           String?
  requiredCredentialType String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  agentSkills            AgentSkill[]
  knowledgeSources       KnowledgeSource[]

  @@unique([domain, version])
  @@index([domain])
  @@index([status])
}

model AgentSkill {
  agentId String
  skillId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id])

  @@id([agentId, skillId])
}

model KnowledgeSource {
  id         String              @id @default(cuid())
  skillId    String
  type       KnowledgeSourceType
  label      String
  rawContent Bytes?
  url        String?
  parsedAt   DateTime?
  createdAt  DateTime            @default(now())
  skill      Skill               @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
}

model Credential {
  id                      String          @id @default(cuid())
  name                    String
  description             String?
  scope                   CredentialScope
  credentialType          CredentialType  @default(API_TOKEN)
  encryptedValue          String
  iv                      String
  authTag                 String
  allowedAgentPermissions String[]        @default([])
  userId                  String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  agents                  Agent[]
  user                    User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  llmConfigs              LLMConfig[]

  @@index([scope])
  @@index([userId])
}

model ApprovalRequest {
  id           String         @id @default(cuid())
  requestId    String         @unique
  reason       String
  status       ApprovalStatus @default(PENDING)
  requestedBy  String
  channel      String
  channelRef   String?
  expiresAt    DateTime
  respondedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  agentRequest AgentRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestor    User           @relation(fields: [requestedBy], references: [id])

  @@index([status])
  @@index([requestedBy])
}

model AgentRequest {
  id          String           @id @default(cuid())
  agentId     String
  userId      String
  status      RequestStatus    @default(QUEUED)
  input       String
  channel     String           @default("api")
  turns       Json             @default("[]")
  toolCalls   Json             @default("[]")
  output      String?
  errorMsg    String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  agent       Agent            @relation(fields: [agentId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  approval    ApprovalRequest?

  @@index([agentId])
  @@index([userId])
  @@index([status])
  @@index([channel])
}

model Endpoint {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  baseUrl      String?
  tags         String[] @default([])
  aliases      String[] @default([])
  notes        String?
  sshEnabled   Boolean  @default(false)
  hostname     String?
  sshPort      Int      @default(22)
  credentialId String?
  sshVerified  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tags])
  @@index([sshEnabled])
}

model ScheduledJob {
  id          String    @id @default(cuid())
  name        String
  description String?
  agentId     String
  cronExpr    String
  input       String
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([agentId])
  @@index([enabled])
}

model Target {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  hostname     String
  sshPort      Int      @default(22)
  tags         String[] @default([])
  notes        String?
  credentialId String?
  sshVerified  Boolean  @default(false)
  apiVerified  Boolean  @default(false)
  apiBaseUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tags])
}

model SkillRegistryEntry {
  id          String   @id @default(cuid())
  domain      String
  version     String
  name        String
  description String?
  manifest    Json
  registryUrl String?
  publishedAt DateTime @default(now())

  @@unique([domain, version])
  @@index([domain])
}

model Persona {
  id                   String   @id @default(cuid())
  name                 String
  goal                 String
  domain               String?
  systemPrompt         String
  requiredSkills       String[] @default([])
  suggestedPermissions String[] @default([])
  schedule             String?
  tags                 String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  agents               Agent[]

  @@index([domain])
}

model DomainConstraint {
  id           String             @id @default(cuid())
  sourceDomain String
  targetDomain String
  compatible   CompatibilityLevel
  notes        String?
  conditions   Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([sourceDomain, targetDomain])
  @@index([sourceDomain])
  @@index([targetDomain])
}

model DynamicTool {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  parameters  Json
  handlerType String
  config      Json
  skillId     String?
  domain      String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([domain])
  @@index([handlerType])
}

model CoordinatorSession {
  id              String        @id @default(cuid())
  userId          String
  turns           Json          @default("[]")
  agentRequestIds String[]      @default([])
  status          RequestStatus @default(RUNNING)
  channel         String        @default("api")
  output          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model MeshEvent {
  id                   String         @id @default(cuid())
  sessionId            String?
  taskType             String
  taskPayload          Json
  requiredCapabilities String[]       @default([])
  assignedAgentId      String?
  status               MeshTaskStatus @default(PENDING)
  result               Json?
  errorMsg             String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([sessionId])
  @@index([status])
  @@index([assignedAgentId])
}

model LLMConfig {
  id           String      @id @default(cuid())
  name         String      @unique
  provider     String
  model        String
  baseUrl      String?
  apiVersion   String?
  isDefault    Boolean     @default(false)
  credentialId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  credential   Credential? @relation(fields: [credentialId], references: [id])

  @@index([isDefault])
}

model UserDashboard {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  agentId     String?
  prompt      String
  widgets     Json      @default("[]")
  refreshMode String    @default("manual")
  cronExpr    String?
  lastData    Json?
  lastRunAt   DateTime?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  meta        Json?

  @@index([slug])
  @@index([status])
}

model DomainKnowledge {
  domain      String   @id
  docIndex    Json     @default("[]")
  entityGraph Json     @default("{}")
  playbooks   Json     @default("[]")
  updatedAt   DateTime @updatedAt
}

enum SkillStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  DEPRECATED
}

enum CredentialScope {
  USER
  SYSTEM
}

enum CredentialType {
  API_TOKEN
  USERNAME_PASSWORD
  SSH_KEY
  BASIC_AUTH
  OAUTH2_CLIENT
  USER_PREFERENCE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

enum RequestStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum KnowledgeSourceType {
  OPENAPI_JSON
  PDF
  MARKDOWN
  URL
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum AgentPosture {
  AUTONOMOUS
  SUPERVISED
  INTERACTIVE
  DELIBERATE
}

enum AgentBearing {
  ANALYTICAL
  CONCISE
  NARRATIVE
  FORMAL
}

enum AgentVerbosity {
  TERSE
  STANDARD
  DETAILED
}

enum CompatibilityLevel {
  FULL
  PARTIAL
  NONE
}

enum MeshTaskStatus {
  PENDING
  ROUTING
  RUNNING
  AGGREGATING
  COMPLETED
  FAILED
}
