// This is the bclaw Prisma schema.
// All services share this schema via the @bclaw/shared package.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum SkillStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  DEPRECATED
}

enum CredentialScope {
  USER
  SYSTEM
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

enum RequestStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum KnowledgeSourceType {
  OPENAPI_JSON
  PDF
  MARKDOWN
  URL
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

// ─── Charter enums ────────────────────────────────────────────────────────────

// How autonomously the agent operates — the interactivity axis.
enum AgentPosture {
  AUTONOMOUS    // Acts independently; notifies on completion only
  SUPERVISED    // Plans independently; approval gates for writes and destructive ops
  INTERACTIVE   // Confirms before each significant action; presents decision options
  DELIBERATE    // Analysis and planning only; awaits explicit instruction before each execution step
}

// How the agent communicates — the bearing axis.
enum AgentBearing {
  ANALYTICAL    // Structured findings, data-forward, minimal commentary
  CONCISE       // Brief, action-oriented responses
  NARRATIVE     // Explanatory prose with reasoning
  FORMAL        // Professional, structured, no colloquialisms
}

// How much detail the agent includes in its responses.
enum AgentVerbosity {
  TERSE
  STANDARD
  DETAILED
}

enum CompatibilityLevel {
  FULL
  PARTIAL
  NONE
}

enum MeshTaskStatus {
  PENDING
  ROUTING
  RUNNING
  AGGREGATING
  COMPLETED
  FAILED
}

// ─── Users & Access Control ───────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  externalId   String   @unique          // identity from IDP / Telegram / Teams
  displayName  String   @default("")
  email        String?  @unique
  passwordHash String?                   // bcrypt hash for local auth
  isSystemUser Boolean  @default(false)  // system users can publish/update skills
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  credentials  Credential[]
  agents       Agent[]
  requests     AgentRequest[]
  approvals    ApprovalRequest[]
}

// ─── Agents ───────────────────────────────────────────────────────────────────

model Agent {
  id          String      @id @default(cuid())
  name        String
  description String?
  status      AgentStatus @default(DRAFT)

  // Persona & behaviour (free-form JSON, validated by skill-engine)
  persona     Json        @default("{}")
  // e.g. { "name": "NetOps", "tone": "concise", "maxTokens": 4096 }

  // LLM configuration
  llmProvider String      @default("openai")  // openai | anthropic | azure-openai
  llmModel    String      @default("gpt-4o")
  llmConfig   Json        @default("{}")       // extra provider params

  // Permissions this agent has been granted
  permissions String[]    @default([])         // e.g. ["read:network", "schedule:jobs"]

  // Skills this agent uses (pinned versions)
  agentSkills AgentSkill[]

  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id])

  // Optional persona template this agent was spawned from
  personaId   String?
  persona_ref Persona?     @relation(fields: [personaId], references: [id])

  // Optional operating charter — defines mandate, posture, bearing
  charterId   String?      @unique
  charter     AgentCharter? @relation(fields: [charterId], references: [id])

  requests    AgentRequest[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

// ─── Agent Charter ────────────────────────────────────────────────────────────
// The AgentCharter defines an agent's operating mandate, behavioral posture,
// and authority boundaries. It is the enterprise equivalent of a behavioral
// framework — every deployed agent should have one.

model AgentCharter {
  id       String @id @default(cuid())

  // What this agent exists to do — injected into every system prompt
  mandate  String

  // How autonomously the agent operates (the interactivity axis)
  posture  AgentPosture @default(SUPERVISED)

  // How the agent communicates
  bearing  AgentBearing @default(CONCISE)

  // How much detail is included in responses
  verbosity AgentVerbosity @default(STANDARD)

  // Actions that always require human approval regardless of posture
  // e.g. ["delete.*", "write:fabric-config", "ssh:exec:reboot"]
  conductBoundaries String[] @default([])

  // Conditions that force immediate escalation
  // e.g. ["severity:CRITICAL", "alarm_count > 10", "config drift detected"]
  escalationTriggers String[] @default([])

  // Optional hard limits on the scope of action
  // e.g. { "maxTargets": 5, "allowedDomains": ["networking.*"] }
  scopeLimits Json?

  agent    Agent?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Skills ───────────────────────────────────────────────────────────────────

model Skill {
  id          String      @id @default(cuid())
  name        String
  domain      String      // e.g. "networking.extreme-xco"
  description String?
  version     String      // semver e.g. "1.2.0"
  status      SkillStatus @default(DRAFT)

  // Capabilities offered by this skill (discoverable by orchestrator)
  capabilities String[]

  // Tools (function definitions the LLM can call)
  tools       Json        @default("[]")
  // Array of { name, description, parameters (JSON Schema), endpoint? }

  // System prompt fragment injected when this skill is active
  systemPrompt String?

  knowledgeSources KnowledgeSource[]
  agentSkills      AgentSkill[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([domain, version])
  @@index([domain])
  @@index([status])
}

// Join table: Agent ↔ Skill (with pinned version)
model AgentSkill {
  agentId  String
  skillId  String
  agent    Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId], references: [id])

  @@id([agentId, skillId])
}

// ─── Knowledge Sources ────────────────────────────────────────────────────────

model KnowledgeSource {
  id          String              @id @default(cuid())
  skillId     String
  skill       Skill               @relation(fields: [skillId], references: [id], onDelete: Cascade)

  type        KnowledgeSourceType
  label       String              // Human-readable label
  rawContent  Bytes?              // For PDFs / uploaded files
  url         String?             // For URL / OpenAPI sources
  parsedAt    DateTime?           // When it was last processed

  createdAt   DateTime @default(now())

  @@index([skillId])
}

// ─── Credentials ──────────────────────────────────────────────────────────────

model Credential {
  id              String          @id @default(cuid())
  name            String
  description     String?
  scope           CredentialScope

  // AES-256-GCM encrypted JSON blob (key management in credential-vault service)
  encryptedValue  String
  iv              String          // base64-encoded initialisation vector
  authTag         String          // base64-encoded GCM auth tag

  // Which agent permissions can request this credential
  allowedAgentPermissions String[] @default([])

  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope])
  @@index([userId])
}

// ─── Approval Requests ────────────────────────────────────────────────────────

model ApprovalRequest {
  id            String         @id @default(cuid())
  requestId     String         @unique  // links to AgentRequest
  agentRequest  AgentRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)

  reason        String         // Human-readable reason for the request
  status        ApprovalStatus @default(PENDING)

  requestedBy   String
  requestor     User           @relation(fields: [requestedBy], references: [id])

  // Notification channel used (telegram | teams | email)
  channel       String
  channelRef    String?        // e.g. Telegram message_id for editing the message

  expiresAt     DateTime       // TTL for the approval
  respondedAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([requestedBy])
}

// ─── Agent Requests (execution log) ──────────────────────────────────────────

model AgentRequest {
  id          String        @id @default(cuid())
  agentId     String
  agent       Agent         @relation(fields: [agentId], references: [id])

  userId      String
  user        User          @relation(fields: [userId], references: [id])

  status      RequestStatus @default(QUEUED)

  // The original user input
  input       String
  // Channel: api | telegram | teams | dashboard
  channel     String        @default("api")

  // LLM conversation turns stored as JSON
  turns       Json          @default("[]")

  // Tool calls made during this request
  toolCalls   Json          @default("[]")

  // Final response
  output      String?
  errorMsg    String?

  approval    ApprovalRequest?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agentId])
  @@index([userId])
  @@index([status])
  @@index([channel])
}

// ─── Endpoints / Systems Registry ────────────────────────────────────────────
// Loaded from a markdown endpoints file; also editable via dashboard

model Endpoint {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  baseUrl     String
  // Tags for discovery (e.g. ["networking", "extreme-xco"])
  tags        String[] @default([])
  // Markdown notes / setup info
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tags])
}

// ─── Scheduled Jobs ───────────────────────────────────────────────────────────

model ScheduledJob {
  id          String   @id @default(cuid())
  name        String
  description String?
  agentId     String
  cronExpr    String   // e.g. "0 * * * *"
  input       String   // JSON-encoded agent input
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agentId])
  @@index([enabled])
}

// ─── Targets (network devices, servers) ──────────────────────────────────────
// Targets represent managed devices/hosts. Credentials are stored in the vault.

model Target {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  hostname     String   // FQDN or IP address
  sshPort      Int      @default(22)
  // Tags for grouping/discovery (e.g. ["xco", "core-switch", "site:london"])
  tags         String[] @default([])
  // Notes / connection hints
  notes        String?
  // Reference to the credential in the vault (username + password/key)
  credentialId String?
  // Whether SSH access has been verified
  sshVerified  Boolean  @default(false)
  // Whether REST API access has been verified
  apiVerified  Boolean  @default(false)
  // Base URL for the target's REST API (if applicable)
  apiBaseUrl   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tags])
}

// ─── Skill Registry Manifest ──────────────────────────────────────────────────
// Tracks skills published to / pulled from the central skill registry.

model SkillRegistryEntry {
  id          String   @id @default(cuid())
  domain      String
  version     String
  name        String
  description String?
  // JSON manifest payload (tools, systemPrompt, capabilities, checksum)
  manifest    Json
  // Registry URL this was pulled from (null = locally published)
  registryUrl String?
  publishedAt DateTime @default(now())

  @@unique([domain, version])
  @@index([domain])
}

// ─── Personas ─────────────────────────────────────────────────────────────────
// Reusable agent templates generated from a goal description by the PersonaFactory.
// Agents can be spawned directly from a Persona.

model Persona {
  id           String   @id @default(cuid())
  name         String
  goal         String   // Natural-language goal that drove persona creation
  domain       String?  // Optional domain hint (e.g. "networking.extreme-xco")

  // LLM-generated system prompt for agents spawned from this persona
  systemPrompt String

  // Required skill domains (resolved at spawn time)
  requiredSkills String[] @default([])

  // Suggested permissions
  suggestedPermissions String[] @default([])

  // Optional cron expression if this persona should run on a schedule
  schedule     String?

  // Tags for discovery
  tags         String[] @default([])

  agents       Agent[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([domain])
}

// ─── Domain Constraints ───────────────────────────────────────────────────────
// Records compatibility between two domain skill sets.
// The Coordinator checks this before composing multi-domain agent tasks.

model DomainConstraint {
  id           String             @id @default(cuid())
  sourceDomain String             // e.g. "networking.extreme-xiq"
  targetDomain String             // e.g. "networking.extreme-xco"
  compatible   CompatibilityLevel // FULL | PARTIAL | NONE

  // Human-readable explanation of the constraint
  notes        String?

  // Optional structured conditions (JSON). E.g. { "minXcoVersion": "3.0", "excludedModels": ["X435"] }
  conditions   Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sourceDomain, targetDomain])
  @@index([sourceDomain])
  @@index([targetDomain])
}

// ─── Dynamic Tools ────────────────────────────────────────────────────────────
// Runtime-generated tools stored in DB so they survive restarts.
// Created by ToolFactory.generate() or via skill builder.

model DynamicTool {
  id          String   @id @default(cuid())
  name        String   @unique
  description String

  // JSON Schema for tool parameters
  parameters  Json

  // How this tool is executed: http_call | skill_invoke | agent_delegate | ssh_exec
  handlerType String

  // Handler-specific configuration (URL template, skillId, agentId, targetId etc.)
  config      Json

  // Optional skill this tool was generated from
  skillId     String?

  // Domain this tool belongs to (for capability routing)
  domain      String?

  enabled     Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([domain])
  @@index([handlerType])
}

// ─── Coordinator Sessions ────────────────────────────────────────────────────
// A CoordinatorSession tracks a multi-turn, potentially multi-agent conversation
// routed through the Coordinator Agent (smart gateway node).

model CoordinatorSession {
  id              String         @id @default(cuid())
  userId          String

  // Serialised conversation turns (coordinator + user + sub-agent results)
  turns           Json           @default("[]")

  // IDs of AgentRequests spawned by this session
  agentRequestIds String[]       @default([])

  // Current high-level status
  status          RequestStatus  @default(RUNNING)

  // Channel this session came in on
  channel         String         @default("api")

  // Final synthesised answer (once COMPLETED)
  output          String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ─── Agent Mesh Events ────────────────────────────────────────────────────────
// Observability log of inter-agent tasks routed through the mesh.

model MeshEvent {
  id              String         @id @default(cuid())

  // The coordinator session that triggered this
  sessionId       String?

  // Task type / description
  taskType        String
  taskPayload     Json

  // Which agent capabilities were required
  requiredCapabilities String[]  @default([])

  // Which agent was selected to handle this
  assignedAgentId String?

  status          MeshTaskStatus @default(PENDING)

  result          Json?
  errorMsg        String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sessionId])
  @@index([status])
  @@index([assignedAgentId])
}
