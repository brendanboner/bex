{
  "name": "@bclaw/cli",
  "version": "0.1.0",
  "description": "bforge — Forge Enterprise Agentic Platform CLI",
  "bin": {
    "bforge": "./dist/bin/bforge.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/bin/bforge.ts",
    "start": "node dist/bin/bforge.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.1",
    "@inquirer/prompts": "^7.3.2",
    "node-fetch": "^3.3.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsx": "^4.19.0",
    "typescript": "*"
  }
}
