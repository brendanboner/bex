# ─── Required secrets ─────────────────────────────────────────────────────────

# PostgreSQL password (generate: openssl rand -hex 16)
POSTGRES_PASSWORD=change-me-strong-password

# Redis password
REDIS_PASSWORD=change-me-redis-password

# JWT secret for API auth (generate: openssl rand -hex 32)
JWT_SECRET=change-me-jwt-secret

# AES-256-GCM key for credential encryption (exactly 64 hex chars / 32 bytes)
CREDENTIAL_VAULT_KEY=change-me-64-hex-chars-credential-vault-key-000000000000000000000

# Pre-issued admin JWT token (generated by make setup)
BCLAW_ADMIN_TOKEN=

# ─── LLM Providers ────────────────────────────────────────────────────────────

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT=

# ─── Skill Registry ───────────────────────────────────────────────────────────

# Bearer token for the standalone skill-registry service
# Set the same value in SKILL_REGISTRY_TOKEN and packages/skill-registry/.env
SKILL_REGISTRY_TOKEN=change-me-registry-token

# ─── Approval / Notification channels ────────────────────────────────────────

DEFAULT_APPROVAL_CHANNEL=telegram   # telegram | teams | whatsapp

# Public URL of the api-gateway (used to generate approval callback links)
PERMISSION_GATEWAY_CALLBACK_URL=https://your-domain.com

# -- Telegram --
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_CHAT_ID=
TELEGRAM_DEFAULT_AGENT_ID=

# Shared bot API key (a pre-issued JWT for bots to call the api-gateway)
BCLAW_BOT_API_KEY=

# -- Microsoft Teams --
TEAMS_APPROVAL_WEBHOOK_URL=
TEAMS_BOT_ID=
TEAMS_BOT_PASSWORD=
TEAMS_DEFAULT_AGENT_ID=

# -- WhatsApp (Twilio) --
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_APPROVAL_TO=whatsapp:+1234567890

# ─── Coordinator ──────────────────────────────────────────────────────────────

COORDINATOR_LLM_PROVIDER=openai
COORDINATOR_LLM_MODEL=gpt-4o

# ─── Agent / Mesh defaults ────────────────────────────────────────────────────

DEFAULT_AGENT_POSTURE=SUPERVISED
MESH_AUTO_START_WORKERS=true

# ─── Dashboard / CORS ─────────────────────────────────────────────────────────

CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4001

# ─── Logging ──────────────────────────────────────────────────────────────────

LOG_LEVEL=info
