# ─── Required secrets ────────────────────────────────────────────────────────
# Run "make setup" to auto-generate these values.

# PostgreSQL password (generate a strong random string)
POSTGRES_PASSWORD=change-me-strong-password

# Redis password
REDIS_PASSWORD=change-me-redis-password

# JWT secret for API auth (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-jwt-secret

# AES-256-GCM key for credential encryption (generate with: openssl rand -hex 32)
# Must be exactly 64 hex chars (32 bytes)
CREDENTIAL_VAULT_KEY=change-me-64-hex-chars-credential-vault-key-000000000000000000000

# Pre-issued admin JWT token (auto-generated by make setup)
BEX_ADMIN_TOKEN=

# ─── LLM Providers (fill in whichever you use) ───────────────────────────────

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT=

# ─── Approval notifications ───────────────────────────────────────────────────
# Set DEFAULT_APPROVAL_CHANNEL to your preferred notification method

DEFAULT_APPROVAL_CHANNEL=telegram   # telegram | teams | whatsapp

# -- Telegram --
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_CHAT_ID=
TELEGRAM_DEFAULT_AGENT_ID=

# Bot API key (a pre-issued JWT for the Telegram bot to call the api-gateway)
BEX_BOT_API_KEY=

# -- Microsoft Teams --
TEAMS_APPROVAL_WEBHOOK_URL=
TEAMS_BOT_ID=
TEAMS_BOT_PASSWORD=
TEAMS_DEFAULT_AGENT_ID=
TEAMS_BOT_ID=
TEAMS_BOT_PASSWORD=

# -- WhatsApp (via Twilio) --
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_APPROVAL_TO=whatsapp:+1234567890

# Public URL of the api-gateway (used to generate approval callback links)
PERMISSION_GATEWAY_CALLBACK_URL=https://your-domain.com

# ─── WhatsApp (Twilio) ────────────────────────────────────────────────────────

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_APPROVAL_TO=whatsapp:+1234567890

# BFORGE API URL (used by the WhatsApp webhook to call approve/deny endpoints)
BEX_API_URL=http://localhost:4000

# ─── Skill Registry ───────────────────────────────────────────────────────────
# Default central registry: https://bexregistry.brendanbonner.com
# To run your own standalone registry: see registry-server/docker-compose.yml
SKILL_REGISTRY_URL=https://bexregistry.brendanbonner.com
SKILL_REGISTRY_TOKEN=your-registry-token-here

# ── Knowledge Store ──────────────────────────────────────────────────────────
# Directory where markdown knowledge files are stored
# In Docker: mount a volume here for persistence
KNOWLEDGE_DIR=./knowledge

# ── Agent Charter Defaults ───────────────────────────────────────────────────
# Default posture for newly created agents without an explicit charter
# AUTONOMOUS | SUPERVISED | INTERACTIVE | DELIBERATE
DEFAULT_AGENT_POSTURE=SUPERVISED

# ── Coordinator ──────────────────────────────────────────────────────────────
# LLM provider + model for the Coordinator Agent (smart gateway node)
COORDINATOR_LLM_PROVIDER=openai
COORDINATOR_LLM_MODEL=gpt-4o

# ── Mesh ─────────────────────────────────────────────────────────────────────
# Whether to auto-start mesh workers for all active agents on startup
MESH_AUTO_START_WORKERS=true

# ─── Dashboard ────────────────────────────────────────────────────────────────

CORS_ORIGIN=http://localhost:3000,http://localhost:8800,http://localhost:8801
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4001
# Public URL of the dashboard app (used to generate dashboard links in Telegram/Teams/WhatsApp)
DASHBOARD_URL=http://localhost:3000

# ─── Logging ─────────────────────────────────────────────────────────────────

LOG_LEVEL=info

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Maximum requests per minute per IP for each service (tune per deployment)
RATE_LIMIT_MAX=100
DASHBOARD_RATE_LIMIT_MAX=200
REGISTRY_RATE_LIMIT_MAX=60
