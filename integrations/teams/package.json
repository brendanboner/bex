{
  "name": "@bex/integration-teams",
  "version": "0.1.0",
  "private": true,
  "description": "Microsoft Teams bot integration — routes messages to api-gateway",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@bex/shared": "*",
    "botbuilder": "^4.23.1",
    "restify": "^11.1.0",
    "undici": "^6.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/restify": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "*"
  }
}
