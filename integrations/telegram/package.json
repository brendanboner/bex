{
  "name": "@bclaw/integration-telegram",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot integration — routes messages to api-gateway",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/bot.ts",
    "start": "node dist/bot.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@bclaw/shared": "*",
    "grammy": "^1.29.0",
    "undici": "^6.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsx": "^4.19.0",
    "typescript": "*"
  }
}
